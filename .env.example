FASTAPI_PORT=42110
REDIS_PORT=6379
CELERY_LOGLEVEL=info
CELERY_POOL=solo
CELERY_CONCURRENCY=1
#
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
DEFAULT_USERNAME=MY_USERNAME
DEFAULT_PASSWORD=MY_PASSWORD
DEFAULT_SECRET_KEY="8a7914c8-3460-4745-80ad-f8b728b9da8c"
TESTING=false
USE_CELERY=false

# Redis configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Celery serialization settings
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# Timezone settings
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True

# Celery worker settings
CELERY_WORKER_CONCURRENCY=1  # Run only one task at a time
CELERY_PREFETCH_MULTIPLIER=1  # No prefetching to avoid overload
CELERY_WORKER_MAX_TASKS_PER_CHILD=1  # Restart worker after each task

# Docker Compose resource limits (to be used in the compose file)
COMPOSE_MEMORY_LIMIT=14G
COMPOSE_CPU_LIMIT=1  # Limit to 1 CPU core per task